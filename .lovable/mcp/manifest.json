{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ltseidxietneylhrhhxm.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "uaitrampo-mcp",
      "version": "0.1.0",
      "title": "UaiTrampo"
    },
    "tools": [
      {
        "name": "get_my_profile",
        "title": "Get my profile",
        "description": "Return the signed-in UaiTrampo worker profile: name, city, state, PIX key, pontuação (career score) and CPF status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_available_services",
        "title": "List available services",
        "description": "List active UaiTrampo services (diárias) the signed-in worker can apply to. Optionally filter by city or category and limit results.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "cidade": {
              "description": "Filter by city name (case-sensitive match).",
              "type": "string"
            },
            "categoria": {
              "description": "Filter by service category.",
              "type": "string"
            },
            "limit": {
              "description": "Max results (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_my_candidaturas",
        "title": "List my applications",
        "description": "List the signed-in worker's UaiTrampo applications (candidaturas), with status, approval and check-in info, plus the linked service title.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "description": "Optional status filter (e.g. pendente, aprovada, recusada).",
              "type": "string"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_my_career",
        "title": "Get my career stats",
        "description": "Return the signed-in worker's UaiTrampo career summary: pontuação, total applications, approved, completed shifts and last 5 ratings received.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
